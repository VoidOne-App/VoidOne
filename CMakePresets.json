{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer (Debug, sanitizers, tests)",
      "description": "Local development build: fast iteration, ASan/UBSan on, tests enabled.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOIDONE_BUILD_TESTS": "ON",
        "VOIDONE_ENABLE_SANITIZERS": "ON",
        "VOIDONE_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release (local)",
      "description": "Optimized local build matching production settings, without CI-only strictness.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VOIDONE_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI (Windows, strict)",
      "description": "Used by GitHub Actions: warnings-as-errors, LTO, tests required to pass.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VOIDONE_BUILD_TESTS": "ON",
        "VOIDONE_WARNINGS_AS_ERRORS": "ON",
        "VOIDONE_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "reproducible",
      "displayName": "Reproducible verification build",
      "description": "For community members verifying a release binary against source. Requires SOURCE_DATE_EPOCH set in the environment before configuring.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VOIDONE_ENABLE_LTO": "OFF",
        "VOIDONE_REPRODUCIBLE_BUILD": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "dev",          "configurePreset": "dev" },
    { "name": "release",      "configurePreset": "release" },
    { "name": "ci-windows",   "configurePreset": "ci-windows" },
    { "name": "reproducible", "configurePreset": "reproducible" }
  ],

  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 120 }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 120 }
    }
  ]
}
