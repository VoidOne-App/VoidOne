<?xml version="1.0" encoding="utf-8"?>
<!-- دریافت خودکار نسخه از کامپایلر -->
<?ifndef ProductVersion ?>
  <?define ProductVersion = "0.1.0.0" ?>
<?endif ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="VoidOne" 
           Manufacturer="VoidOne_app" 
           Version="$(var.ProductVersion)" 
           UpgradeCode="B6E1A0B2-9F3D-4C7A-B1C2-3D4E5F6A7B8C" 
           Scope="perMachine"
           InstallerVersion="500">

    <!-- 1. بررسی سیستم‌عامل 64 بیتی -->
    <Launch Message="این نرم‌افزار نیازمند سیستم‌عامل 64 بیتی (Windows 10/11 x64) است." 
            Condition="VersionNT64" />

    <!-- 2. بستن خودکار پروسه‌ها -->
    <util:CloseApplication Id="CloseVoidoneApp"
                           Target="VoidOne.exe"
                           CloseMessage="yes"
                           PromptToContinue="yes"
                           Description="جهت ادامه فرایند، نرم‌افزار VoidOne باید بسته شود." />

    <!-- 3. ارتقاء خودکار -->
    <MajorUpgrade DowngradeErrorMessage="نسخه جدیدتری از VoidOne قبلاً روی سیستم شما نصب شده است."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 4. تنظیمات Control Panel -->
    <Property Id="ARPCOMMENTS" Value="VoidOne High-Performance Gamer Engine" />
    <Property Id="ARPCONTACT" Value="VoidOne_app Support Team" />
    <Property Id="ARPHELPLINK" Value="https://github.com/VoidOne-App/NeonLauncher-Qt/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VoidOne-App/NeonLauncher-Qt" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Icon Id="AppIcon.ico" SourceFile="app-icon.ico" />

    <!-- 5. پوشه‌ها -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VoidOne" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="VoidOne" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- 6. بسته‌بندی فایل‌ها و ریجستری‌ها -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="package\**" />

      <Component Id="GamerIntegrationComponent" Guid="C3D4E5F6-A7B8-9C0D-1E2F-3A4B5C6D7E8F">
        
        <fw:FirewallException Id="VoidoneFirewallRule"
                              Name="VoidOne Engine Service"
                              Target="[INSTALLFOLDER]VoidOne.exe"
                              Scope="any"
                              IgnoreFailure="yes" />

        <ProgId Id="VoidOne.ProjectFile" Description="VoidOne Project File" Icon="AppIcon.ico">
          <Extension Id="vone" ContentType="application/x-voidone">
            <Verb Id="open" Command="Open with VoidOne" Target="[INSTALLFOLDER]VoidOne.exe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <RegistryKey Root="HKCR" Key="voidone">
          <RegistryValue Type="string" Value="URL:VoidOne Protocol" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]VoidOne.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]VoidOne.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>

        <RegistryKey Root="HKCR" Key="Directory\shell\VoidOne">
          <RegistryValue Type="string" Value="Open with VoidOne" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]VoidOne.exe,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]VoidOne.exe&quot; &quot;--game-path=%1&quot;" />
          </RegistryKey>
        </RegistryKey>

        <RegistryValue Root="HKMU" Key="Software\VoidOne_app\VoidOne" Name="EnterpriseIntegrated" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 7. شورت‌کت‌ها -->
    <ComponentGroup Id="ShortcutComponents">

      <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="VoidOne"
                  Description="Launch VoidOne Engine"
                  Target="[INSTALLFOLDER]VoidOne.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanUpStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\VoidOne_app\VoidOne" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="B2C3D4E5-F6A7-8B9C-0D1E-2F3A4B5C6D7E">
        <Shortcut Id="DesktopShortcut"
                  Name="VoidOne"
                  Description="Launch VoidOne Engine"
                  Target="[INSTALLFOLDER]VoidOne.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKMU" Key="Software\VoidOne_app\VoidOne" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="StartupShortcutComponent" Directory="INSTALLFOLDER" Guid="D4E5F6A7-B8C9-0D1E-2F3A-4B5C6D7E8F9A">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="VoidOne" Type="string" Value="&quot;[INSTALLFOLDER]VoidOne.exe&quot; --autostart" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- 8. پیش‌نیازها -->
    <CustomAction Id="InstallVCRedist"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]VC_redist.x64.exe&quot; /install /quiet /norestart"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Id="InstallVCRedist" Before="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- 9. رابط کاربری -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="اجرای فوری VoidOne" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]VoidOne.exe" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X86" DllEntry="WixShellExec" Impersonate="yes" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- 10. فیچر اصلی -->
    <Feature Id="MainFeature" Title="VoidOne Core" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

  </Package>
</Wix>
