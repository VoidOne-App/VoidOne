<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="VoidOne" 
           Manufacturer="VoidOne-App" 
           Version="0.0.1.0" 
           UpgradeCode="B6E1A0B2-9F3D-4C7A-B1C2-3D4E5F6A7B8C" 
           Scope="perMachine"
           InstallerVersion="500">

    <!-- جلوگیری از نصب روی سیستم‌های 32 بیتی (چون پکیج 64 بیتی است) -->
    <Launch Message="This application requires a 64-bit version of Windows." 
            Condition="VersionNT64" />
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />
                  
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Control Panel / Add-Remove Programs Properties (Commercial Look) -->
    <Property Id="ARPCOMMENTS" Value="VoidOne Open-Source High-Performance Engine" />
    <Property Id="ARPCONTACT" Value="VoidOne-App Support Team" />
    <Property Id="ARPHELPLINK" Value="https://github.com/VoidOne-App/VoidOne/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VoidOne-App/VoidOne" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPSIZE" Value="50000" /> <!-- اختیاری: تخمین سایز برای نمایش دقیق‌تر -->

    <!-- Application Icon -->
    <Icon Id="AppIcon.ico" SourceFile="app-icon.ico" />

    <!-- Target Directory Structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VoidOne" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="VoidOne"/>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- 1. Application Core Files -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="package\**" />
    </ComponentGroup>

    <!-- 2. Start Menu & Desktop Shortcuts -->
    <ComponentGroup Id="ShortcutComponents">
      
      <!-- Start Menu Shortcut -->
      <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="VoidOne"
                  Description="Launch VoidOne Application"
                  Target="[INSTALLFOLDER]VoidOne.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        
        <RemoveFolder Id="CleanUpStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\VoidOne-App\VoidOne" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Desktop Shortcut -->
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="B2C3D4E5-F6A7-8B9C-0D1E-2F3A4B5C6D7E">
        <Shortcut Id="DesktopShortcut"
                  Name="VoidOne"
                  Description="Launch VoidOne Application"
                  Target="[INSTALLFOLDER]VoidOne.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
                  
        <RegistryValue Root="HKMU" Key="Software\VoidOne-App\VoidOne" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      
    </ComponentGroup>

    <!-- Graphical UI Wizard با ظاهر استاندارد و حرفه‌ای -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    
    <!-- لایسنس‌نامه (در صورت داشتن فایل license.rtf در کنار فایل wxs آن را فعال کنید) -->
    <!-- <WixVariable Id="WixUILicenseRtf" Value="license.rtf" /> -->

    <!-- Main Feature Definition -->
    <Feature Id="MainFeature" Title="VoidOne Core" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>
</Wix>
